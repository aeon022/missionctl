---
export interface Props {
  title: string;
  price: string;
  features: string[];
  features_de?: string[];
  ctaText: string;
  ctaText_de?: string;
  ctaHref: string;
  highlighted?: boolean;
  badge?: string;
  badge_de?: string;
  note?: string;
  note_de?: string;
}

const { title, price, features, features_de, ctaText, ctaText_de, ctaHref, highlighted = false, badge, badge_de, note, note_de } = Astro.props;
---

<div style={`
  background: ${highlighted ? 'rgba(var(--color-terminal-green-rgb),0.04)' : 'var(--color-terminal-surface)'};
  border: ${highlighted ? '2px solid rgba(var(--color-terminal-green-rgb),0.4)' : '1px solid var(--color-terminal-border)'};
  border-radius: 8px;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  position: relative;
  ${highlighted ? 'box-shadow: 0 0 40px rgba(var(--color-terminal-green-rgb),0.08);' : ''}
  transition: border-color 0.2s, box-shadow 0.2s;
`} class="pricing-card">

  <!-- Badge -->
  {badge && (
    <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);">
      <span style="
        background: var(--color-terminal-green);
        color: var(--color-terminal-bg);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.75rem;
        border-radius: 20px;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      "><span class="lang-en">{badge}</span><span class="lang-de">{badge_de ?? badge}</span></span>
    </div>
  )}

  <!-- Title + Price -->
  <div>
    <h3 style={`
      font-family: 'JetBrains Mono', monospace;
      font-size: 1rem;
      font-weight: 700;
      color: ${highlighted ? 'var(--color-terminal-green)' : 'var(--color-terminal-text)'};
      margin: 0 0 0.5rem;
    `}>{title}</h3>
    <div style="display: flex; align-items: baseline; gap: 0.25rem;">
      <span style={`
        font-size: 2rem;
        font-weight: 800;
        color: ${highlighted ? 'var(--color-terminal-green)' : 'var(--color-terminal-text)'};
        line-height: 1;
      `}>{price}</span>
      <span style="color: var(--color-terminal-muted); font-size: 0.85rem;">USD</span>
    </div>
    <p style="color: var(--color-terminal-muted); font-size: 0.75rem; margin: 0.35rem 0 0; font-family: 'JetBrains Mono', monospace;"><span class="lang-en">one-time purchase</span><span class="lang-de">Einmalkauf</span></p>
  </div>

  <!-- Features -->
  <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
    {features.map((f, i) => (
      <li style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; color: var(--color-terminal-code-text);">
        <span style={`color: ${highlighted ? 'var(--color-terminal-green)' : 'var(--color-terminal-muted)'}; font-family: monospace; flex-shrink: 0; margin-top: 1px;`}>&#x2713;</span>
        <span class="lang-en">{f}</span><span class="lang-de">{features_de?.[i] ?? f}</span>
      </li>
    ))}
  </ul>

  <!-- Note -->
  {note && <p style="color: var(--color-terminal-muted); font-size: 0.75rem; margin: 0; font-style: italic;"><span class="lang-en">{note}</span><span class="lang-de">{note_de ?? note}</span></p>}

  <!-- CTA -->
  <a
    href={ctaHref}
    target="_blank"
    rel="noopener"
    style={`
      display: block;
      text-align: center;
      padding: 0.75rem 1rem;
      border-radius: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
      ${highlighted
        ? 'background: var(--color-terminal-green); color: var(--color-terminal-bg);'
        : 'background: transparent; color: var(--color-terminal-text); border: 1px solid var(--color-terminal-border);'
      }
    `}
    class={highlighted ? 'pricing-cta-primary' : 'pricing-cta-secondary'}
  >
    <span class="lang-en">{ctaText}</span><span class="lang-de">{ctaText_de ?? ctaText}</span>
  </a>
</div>

<style>
  .pricing-cta-primary:hover {
    background: var(--color-terminal-green-hover) !important;
    transform: translateY(-1px);
  }
  .pricing-cta-secondary:hover {
    border-color: rgba(var(--color-terminal-green-rgb),0.4) !important;
    color: var(--color-terminal-green) !important;
  }
  .pricing-card:not([style*="border: 2px"]):hover {
    border-color: rgba(var(--color-hover-tint),0.1) !important;
    transform: translateY(-3px);
  }
  .pricing-card {
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s cubic-bezier(0.4,0,0.2,1);
  }
  .pricing-card[style*="border: 2px"] {
    animation: pricing-glow-pulse 3.2s ease-in-out infinite;
  }
  @keyframes pricing-glow-pulse {
    0%, 100% { box-shadow: 0 0 40px rgba(var(--color-terminal-green-rgb),0.08); }
    50%      { box-shadow: 0 0 56px rgba(var(--color-terminal-green-rgb),0.16); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pricing-card[style*="border: 2px"] { animation: none; }
  }
</style>
