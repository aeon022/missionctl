---
// "Give your AI hands": the AI sits in the middle, tool calls fly out to the apps, results flow back
// into a morning briefing. Pure SVG + a small script; static final state with reduced motion.
const R = 190, C = 260, NR = 27;
const apps = [
  { name: 'mailctl',   href: '/mailctl',   color: '#00d97e', glyph: '✉', tools: 6,  en: '7 unread',          de: '7 ungelesen' },
  { name: 'calctl',    href: '/calctl',    color: '#6366f1', glyph: '▦', tools: 7,  en: '4 events',          de: '4 Termine' },
  { name: 'taskctl',   href: '/taskctl',   color: '#f59e0b', glyph: '✓', tools: 7,  en: '3 due today',       de: '3 heute fällig' },
  { name: 'notectl',   href: '/notectl',   color: '#a78bfa', glyph: '✎', tools: 8,  en: 'note saved',        de: 'Notiz gespeichert' },
  { name: 'budgetctl', href: '/budgetctl', color: '#10b981', glyph: '€', tools: 11, en: '€1,240 left',       de: '€1.240 übrig' },
  { name: 'diaryctl',  href: '/diaryctl',  color: '#fb923c', glyph: '❝', tools: 5,  en: '12 commits',        de: '12 Commits' },
  { name: 'timectl',   href: '/timectl',   color: '#22d3ee', glyph: '◷', tools: 4,  en: '4h 20m logged',     de: '4 h 20 min erfasst' },
  { name: 'habctl',    href: '/habctl',    color: '#84cc16', glyph: '↻', tools: 12, en: '1 streak at risk',  de: '1 Streak in Gefahr' },
  { name: 'postctl',   href: 'https://postctl.sh', color: '#ec4899', glyph: '➤', tools: 7, en: '9 scheduled',  de: '9 geplant', ext: true },
].map((a, i, all) => {
  const ang = (-90 + (360 / all.length) * i) * Math.PI / 180;
  const x = +(C + R * Math.cos(ang)).toFixed(1), y = +(C + R * Math.sin(ang)).toFixed(1);
  const side = Math.cos(ang) > 0.3 ? 'r' : Math.cos(ang) < -0.3 ? 'l' : Math.sin(ang) < 0 ? 't' : 'b';
  return { ...a, x, y, side };
});
---
<div class="hs" id="hero-scene">
  <div class="hs-prompt" aria-hidden="true">
    <span class="hs-user">you</span>
    <span class="hs-typed" id="hs-typed"></span><span class="hs-caret"></span>
  </div>
  <span hidden id="hs-prompt-src"><span class="lang-en">Give me a morning briefing</span><span class="lang-de">Gib mir ein Morgenbriefing</span></span>

  <div class="hs-stage" id="hs-stage">
    <svg viewBox="0 0 520 520" class="hs-svg" role="img" aria-label="An AI in the centre calls tools in nine local apps: mailctl, calctl, taskctl, notectl, budgetctl, diaryctl, timectl, habctl and postctl.">
      <defs>
        <radialGradient id="hs-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="rgba(var(--color-terminal-green-rgb),.55)"/>
          <stop offset="100%" stop-color="rgba(var(--color-terminal-green-rgb),0)"/>
        </radialGradient>
        <filter id="hs-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <circle cx={C} cy={C} r={R} class="hs-orbit"/>
      <circle cx={C} cy={C} r={R + 34} class="hs-orbit hs-orbit-outer"/>
      <circle cx={C} cy={C} r="120" fill="url(#hs-core)" class="hs-aura"/>
      {apps.map((a, i) => (
        <g>
          <path d={`M${C},${C} L${a.x},${a.y}`} class="hs-beam" data-i={i} style={`--c:${a.color}`}/>
        </g>
      ))}
      <circle class="hs-packet" r="4.5" cx={C} cy={C} filter="url(#hs-glow)"/>
      <g class="hs-core-node">
        <circle cx={C} cy={C} r="46" class="hs-core-ring"/>
        <circle cx={C} cy={C} r="38" class="hs-core-fill"/>
        <text x={C} y={C + 6} text-anchor="middle" class="hs-core-text">AI</text>
      </g>
      {apps.map((a, i) => (
        <a href={a.href} {...(a.ext ? { target: '_blank', rel: 'noopener' } : {})} class="hs-node" data-i={i} style={`--c:${a.color}`} aria-label={`${a.name}, ${a.tools} MCP tools`}>
          <circle cx={a.x} cy={a.y} r={NR + 9} class="hs-pulse"/>
          <circle cx={a.x} cy={a.y} r={NR} class="hs-disc"/>
          <text x={a.x} y={a.y + 6} text-anchor="middle" class="hs-glyph">{a.glyph}</text>
          <text x={a.x} y={a.y + NR + 17} text-anchor="middle" class="hs-name">{a.name}</text>
        </a>
      ))}
    </svg>
    {apps.map((a, i) => (
      <span class={`hs-chip hs-chip-${a.side}`} data-i={i} style={`left:${(a.x / 5.2).toFixed(2)}%;top:${(a.y / 5.2).toFixed(2)}%;--c:${a.color}`}>
        <span class="lang-en">{a.en}</span><span class="lang-de">{a.de}</span>
      </span>
    ))}
  </div>

  <div class="hs-status" id="hs-status" aria-hidden="true"></div>

  <div class="hs-brief" id="hs-brief">
    <span class="hs-brief-tag"><span class="lang-en">briefing</span><span class="lang-de">Briefing</span></span>
    <span class="lang-en">7 unread · 4 events · 3 due · 1 streak at risk · €1,240 left</span>
    <span class="lang-de">7 ungelesen · 4 Termine · 3 fällig · 1 Streak in Gefahr · €1.240 übrig</span>
  </div>
</div>

<style is:global>
  .hs { position: relative; width: 100%; max-width: 540px; margin: 0 auto; display: flex; flex-direction: column; gap: .9rem; }
  .hs-prompt { display: flex; align-items: center; gap: .6rem; align-self: center; min-height: 2.6rem; padding: .55rem 1rem; border: 1px solid var(--color-terminal-border); border-radius: 999px; background: rgba(var(--color-terminal-bg-rgb), .65); backdrop-filter: blur(10px); font-family: var(--font-mono); font-size: .85rem; color: var(--color-terminal-text); box-shadow: 0 8px 30px rgba(0,0,0,.25); }
  .hs-user { font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-terminal-bg); background: var(--color-terminal-green); padding: .15rem .5rem; border-radius: 999px; font-weight: 700; }
  .hs-caret { width: 7px; height: 1.05em; background: var(--color-terminal-green); animation: hs-blink 1s steps(1) infinite; }
  @keyframes hs-blink { 50% { opacity: 0; } }

  .hs-stage { position: relative; transition: transform .25s ease-out; transform-style: preserve-3d; will-change: transform; }
  .hs-svg { width: 100%; height: auto; display: block; overflow: hidden; } /* everything is drawn inside the viewBox; a rotating ring must not widen the page */
  .hs-orbit { fill: none; stroke: var(--color-terminal-border); stroke-width: 1; stroke-dasharray: 3 7; }
  .hs-orbit-outer { stroke-opacity: .5; animation: hs-spin 90s linear infinite; transform-origin: 260px 260px; }
  @keyframes hs-spin { to { transform: rotate(360deg); } }
  .hs-aura { animation: hs-breathe 5s ease-in-out infinite; transform-origin: 260px 260px; }
  @keyframes hs-breathe { 0%,100% { opacity: .55; transform: scale(.92); } 50% { opacity: 1; transform: scale(1.06); } }

  .hs-core-ring { fill: none; stroke: var(--color-terminal-green); stroke-width: 1.5; stroke-dasharray: 60 22; transform-origin: 260px 260px; animation: hs-spin 9s linear infinite; }
  .hs-core-fill { fill: var(--color-terminal-bg); stroke: rgba(var(--color-terminal-green-rgb), .55); stroke-width: 1; }
  .hs-core-text { font-family: var(--font-mono); font-weight: 800; font-size: 20px; fill: var(--color-terminal-green); letter-spacing: .05em; }
  .hs-core-node.fire .hs-core-fill { animation: hs-flash .6s ease-out; }
  @keyframes hs-flash { 0% { fill: rgba(var(--color-terminal-green-rgb), .45); } 100% { fill: var(--color-terminal-bg); } }

  .hs-beam { fill: none; stroke: var(--c); stroke-width: 1.4; stroke-opacity: .12; stroke-linecap: round; }
  .hs-beam.on { stroke-opacity: .85; stroke-dasharray: 6 5; animation: hs-dash .9s linear infinite; filter: drop-shadow(0 0 4px var(--c)); }
  @keyframes hs-dash { to { stroke-dashoffset: -22; } }
  .hs-packet { fill: #fff; opacity: 0; }

  .hs-node { cursor: pointer; outline: none; }
  .hs-disc { fill: var(--color-terminal-bg); stroke: var(--c); stroke-width: 1.5; transition: transform .25s, filter .25s; transform-box: fill-box; transform-origin: center; }
  .hs-glyph { font-size: 17px; fill: var(--c); font-family: var(--font-mono); pointer-events: none; }
  .hs-name { font-size: 10.5px; fill: var(--color-terminal-dim); font-family: var(--font-mono); pointer-events: none; transition: fill .2s; }
  .hs-pulse { fill: none; stroke: var(--c); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .hs-node.hit .hs-pulse { animation: hs-ping .9s ease-out; }
  .hs-node.hit .hs-disc, .hs-node:hover .hs-disc, .hs-node:focus-visible .hs-disc { filter: drop-shadow(0 0 10px var(--c)); transform: scale(1.12); }
  .hs-node.hit .hs-name, .hs-node:hover .hs-name { fill: var(--c); }
  @keyframes hs-ping { 0% { opacity: .9; transform: scale(.7); } 100% { opacity: 0; transform: scale(1.7); } }

  .hs-chip { position: absolute; z-index: 2; padding: .2rem .55rem; border: 1px solid var(--c); border-radius: 6px; background: rgba(var(--color-terminal-bg-rgb), .92); color: var(--color-terminal-text); font-family: var(--font-mono); font-size: .68rem; white-space: nowrap; opacity: 0; transition: opacity .35s, transform .35s; pointer-events: none; box-shadow: 0 0 14px color-mix(in srgb, var(--c) 35%, transparent); }
  .hs-chip-r { transform: translate(40px, -50%) translateX(-8px); }
  .hs-chip-l { transform: translate(calc(-100% - 40px), -50%) translateX(8px); }
  .hs-chip-t { transform: translate(-50%, calc(-100% - 38px)) translateY(8px); }
  .hs-chip-b { transform: translate(-50%, 44px) translateY(-8px); }
  .hs-chip.on { opacity: 1; }
  .hs-chip-r.on { transform: translate(40px, -50%); } .hs-chip-l.on { transform: translate(calc(-100% - 40px), -50%); }
  .hs-chip-t.on { transform: translate(-50%, calc(-100% - 38px)); } .hs-chip-b.on { transform: translate(-50%, 44px); }

  .hs-brief { align-self: center; max-width: 100%; padding: .65rem 1.1rem; border: 1px solid rgba(var(--color-terminal-green-rgb), .45); border-radius: 10px; background: rgba(var(--color-terminal-green-rgb), .08); font-family: var(--font-mono); font-size: .76rem; color: var(--color-terminal-text); text-align: center; line-height: 1.5; opacity: 0; transform: translateY(10px); transition: opacity .5s, transform .5s; }
  .hs-brief.on { opacity: 1; transform: none; }
  .hs-brief-tag { display: inline-block; margin-right: .5rem; padding: .05rem .45rem; border-radius: 4px; background: var(--color-terminal-green); color: var(--color-terminal-bg); font-weight: 700; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }

  .hs-status { display: none; align-self: center; min-height: 1.9rem; padding: .3rem .8rem; border: 1px solid var(--c, var(--color-terminal-border)); border-radius: 8px; font-family: var(--font-mono); font-size: .8rem; color: var(--color-terminal-text); background: rgba(var(--color-terminal-bg-rgb), .8); opacity: 0; transition: opacity .3s; }
  .hs-status.on { opacity: 1; }
  @media (max-width: 1320px) {
    .hs-chip { display: none; }          /* chips of the right-hand nodes would run off the screen */
    .hs-status { display: block; }
  }
  @media (max-width: 640px) {
    .hs-chip { display: none; }          /* chips would run off the screen on the right-hand nodes */
    .hs-status { display: block; }
    .hs-name { font-size: 10.5px; }
    .hs-prompt { font-size: .8rem; }
    .hs-brief { font-size: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs-orbit-outer, .hs-aura, .hs-core-ring, .hs-caret, .hs-beam.on { animation: none !important; }
    .hs-brief { opacity: 1; transform: none; }
  }
</style>

<script>
  // Re-initialised after every ClientRouter navigation (module scripts only run once); the previous
  // run is cancelled through its AbortController.
  let ctl: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    ctl?.abort();
    ctl = new AbortController();
    const sig = ctl.signal;
    const root = document.getElementById('hero-scene');
  if (root && !sig.aborted) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const typed = document.getElementById('hs-typed')!;
    const brief = document.getElementById('hs-brief')!;
    const stage = document.getElementById('hs-stage')!;
    const core = root.querySelector('.hs-core-node')!;
    const packet = root.querySelector<SVGCircleElement>('.hs-packet')!;
    const beams = Array.from(root.querySelectorAll<SVGPathElement>('.hs-beam'));
    const nodes = Array.from(root.querySelectorAll<SVGElement>('.hs-node'));
    const chips = Array.from(root.querySelectorAll<HTMLElement>('.hs-chip'));
    const status = document.getElementById('hs-status')!;
    const prompt = (document.getElementById('hs-prompt-src')!.querySelector('span:not([hidden])') as HTMLElement | null)?.textContent
      ?? document.getElementById('hs-prompt-src')!.textContent ?? '';
    // order in which the AI "reaches" for its hands: mail, calendar, tasks, habits, budget, posts
    const order = [0, 1, 2, 7, 4, 8];
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    let alive = true;
    let running = false;

    const reset = () => {
      typed.textContent = '';
      brief.classList.remove('on');
      beams.forEach((b) => b.classList.remove('on'));
      nodes.forEach((n) => n.classList.remove('hit'));
      chips.forEach((c) => c.classList.remove('on'));
      packet.style.opacity = '0';
      status.classList.remove('on');
    };

    const fly = (i: number) => new Promise<void>((resolve) => {
      const beam = beams[i];
      const len = beam.getTotalLength();
      const t0 = performance.now(), dur = 620;
      beam.classList.add('on');
      core.classList.remove('fire'); void (core as SVGElement).getBoundingClientRect(); core.classList.add('fire');
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        const e = 1 - Math.pow(1 - k, 3);
        const p = beam.getPointAtLength(len * e);
        packet.setAttribute('cx', String(p.x)); packet.setAttribute('cy', String(p.y));
        packet.style.opacity = String(k < 1 ? 1 : 0);
        if (k < 1) requestAnimationFrame(step);
        else {
          nodes[i].classList.add('hit'); chips[i].classList.add('on');
          status.textContent = `${nodes[i].getAttribute('aria-label')?.split(',')[0]} → ${chips[i].textContent?.trim()}`;
          status.style.setProperty('--c', getComputedStyle(nodes[i]).getPropertyValue('--c'));
          status.classList.add('on');
          resolve();
        }
      };
      requestAnimationFrame(step);
    });

    async function loop() {
      if (running) return;
      running = true;
      while (alive && !sig.aborted) {
        reset();
        for (const ch of prompt) { if (!alive || sig.aborted) break; typed.textContent += ch; await wait(55 + Math.random() * 40); }
        await wait(500);
        for (const i of order) { if (!alive || sig.aborted) break; await fly(i); await wait(260); }
        await wait(350);
        brief.classList.add('on');
        await wait(5200);
      }
      running = false;
    }

    if (reduce) {
      typed.textContent = prompt;
      order.forEach((i) => { beams[i].classList.add('on'); chips[i].classList.add('on'); nodes[i].classList.add('hit'); });
      brief.classList.add('on');
    } else {
      // only run while visible
      const io = new IntersectionObserver(([e]) => { alive = e.isIntersecting; if (alive) loop(); }, { threshold: 0.15 });
      io.observe(root);
      sig.addEventListener('abort', () => io.disconnect());
      // gentle 3D tilt that follows the pointer
      const hero = document.getElementById('hero-section') ?? root;
      hero.addEventListener('mousemove', (e: MouseEvent) => {
        const r = root.getBoundingClientRect();
        const nx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
        const ny = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
        stage.style.transform = `perspective(900px) rotateY(${nx * 14}deg) rotateX(${-ny * 12}deg)`;
      }, { passive: true, signal: sig });
      hero.addEventListener('mouseleave', () => { stage.style.transform = ''; }, { signal: sig });
    }
  }
  });
</script>
