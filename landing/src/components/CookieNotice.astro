<div id="cookie-banner" style="
  display: none;
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  background: var(--color-terminal-surface);
  border: 1px solid var(--color-terminal-border);
  border-radius: 8px;
  padding: 0.75rem 1.25rem;
  align-items: center;
  gap: 1rem;
  max-width: 520px;
  width: calc(100% - 2rem);
  box-shadow: 0 4px 24px rgba(0,0,0,0.5);
">
  <p style="color: var(--color-terminal-dim); font-size: 0.8rem; margin: 0; flex: 1; line-height: 1.5;">
    <span class="lang-en">We use essential cookies only. No tracking or analytics.</span>
    <span class="lang-de">Wir verwenden nur essenzielle Cookies. Kein Tracking, keine Analyse.</span>
    <a href="/cookies" style="color: var(--color-terminal-green); text-decoration: none;"><span class="lang-en">Learn more</span><span class="lang-de">Mehr erfahren</span></a>
  </p>
  <button
    id="cookie-accept"
    style="
      background: var(--color-terminal-green);
      color: var(--color-terminal-bg);
      border: none;
      border-radius: 4px;
      padding: 0.4rem 0.875rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      font-family: 'JetBrains Mono', monospace;
      transition: background 0.15s;
    "
  >OK</button>
</div>

<script>
  (function () {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    if (!localStorage.getItem('cookie-accepted')) {
      banner.style.display = 'flex';
    }
    document.getElementById('cookie-accept')?.addEventListener('click', function () {
      localStorage.setItem('cookie-accepted', '1');
      banner.style.display = 'none';
    });
  })();
</script>
