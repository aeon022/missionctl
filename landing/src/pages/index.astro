---
import Layout from '../components/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import AppCard from '../components/AppCard.astro';

const apps = [
  {
    name: 'mailctl',
    href: '/mailctl',
    description: 'Read inbox, compose and send email via Apple Mail. AI draft replies with one keystroke.',
    description_de: 'Posteingang lesen, E-Mails verfassen und senden über Apple Mail. KI-Antwortentwürfe mit einem Tastendruck.',
    mcpCount: 6,
    features: ['TUI inbox with threading', 'AI draft reply (a-key, Bundle)', 'Full-text search', 'MCP server for AI access'],
    features_de: ['TUI-Posteingang mit Threading', 'KI-Antwortentwurf (a-Taste, Bundle)', 'Volltextsuche', 'MCP-Server für KI-Zugriff'],
  },
  {
    name: 'calctl',
    href: '/calctl',
    description: 'Browse calendar, create events, find free slots via Apple Calendar. Summarize meetings with Claude.',
    description_de: 'Kalender durchsuchen, Termine erstellen, freie Slots finden über Apple Kalender. Meetings mit Claude zusammenfassen.',
    mcpCount: 7,
    features: ['TUI week/month view', 'Apple Calendar sync', 'Free slot finder', 'AI meeting summaries (Bundle)'],
    features_de: ['TUI Wochen-/Monatsansicht', 'Apple-Kalender-Sync', 'Freie-Slot-Finder', 'KI-Meeting-Zusammenfassungen (Bundle)'],
  },
  {
    name: 'taskctl',
    href: '/taskctl',
    description: 'Manage tasks with Apple Reminders sync, Pomodoro timer, and background daemon.',
    description_de: 'Aufgaben verwalten mit Apple-Erinnerungen-Sync, Pomodoro-Timer und Hintergrund-Daemon.',
    mcpCount: 7,
    features: ['Apple Reminders sync', 'Built-in Pomodoro timer', 'Batch task operations', 'Background daemon mode'],
    features_de: ['Apple-Erinnerungen-Sync', 'Eingebauter Pomodoro-Timer', 'Stapelverarbeitung von Aufgaben', 'Hintergrund-Daemon-Modus'],
  },
  {
    name: 'notectl',
    href: '/notectl',
    description: 'Obsidian vault notes and daily notes via MCP. Works on macOS and Linux.',
    description_de: 'Obsidian-Vault-Notizen und Daily Notes über MCP. Läuft unter macOS und Linux.',
    mcpCount: 7,
    features: ['Obsidian vault support', 'Daily note automation', 'Full-text search', 'Tag-based filtering', 'Multiple vaults (Bundle)'],
    features_de: ['Unterstützung für Obsidian-Vaults', 'Daily-Note-Automatisierung', 'Volltextsuche', 'Tag-basierte Filterung', 'Mehrere Vaults (Bundle)'],
  },
  {
    name: 'budgetctl',
    href: '/budgetctl',
    description: 'Import bank CSV, categorize transactions, set budget goals. AI categorization & recurring detection with the Bundle.',
    description_de: 'Bank-CSV importieren, Transaktionen kategorisieren, Budgetziele setzen. KI-Kategorisierung & Erkennung wiederkehrender Zahlungen mit dem Bundle.',
    mcpCount: 11,
    features: ['N26, ING, DKB CSV import', 'AI auto-categorization (Bundle)', 'Budget goals with progress', 'Recurring payment detection (Bundle)'],
    features_de: ['N26-, ING-, DKB-CSV-Import', 'KI-Auto-Kategorisierung (Bundle)', 'Budgetziele mit Fortschritt', 'Erkennung wiederkehrender Zahlungen (Bundle)'],
  },
  {
    name: 'diaryctl',
    href: '/diaryctl',
    description: 'Reads git history and generates AI narrative diary entries. Syncs back to Obsidian vault automatically.',
    description_de: 'Liest die Git-Historie und erstellt KI-generierte Tagebucheinträge. Synchronisiert automatisch zurück in den Obsidian-Vault.',
    mcpCount: 5,
    features: ['Git history reader', 'AI narrative entries', 'Obsidian write-back', 'Export for postctl pipeline'],
    features_de: ['Git-Historie-Reader', 'KI-generierte Einträge', 'Obsidian-Rückschreibung', 'Export für postctl-Pipeline'],
  },
  {
    name: 'timectl',
    href: '/timectl',
    description: 'Start/stop timers, weekly bar chart, live TUI. Link timers to tasks, navigate days, generate invoices.',
    description_de: 'Timer starten/stoppen, Wochen-Balkendiagramm, Live-TUI. Timer mit Aufgaben verknüpfen, Tage navigieren, Rechnungen erstellen.',
    mcpCount: 4,
    features: ['taskctl integration (T-key)', 'Invoice export (--month)', 'Day navigation (←/→/t)', 'Daily goal bar'],
    features_de: ['taskctl-Integration (T-Taste)', 'Rechnungsexport (--month)', 'Tagesnavigation (←/→/t)', 'Tagesziel-Balken'],
  },
  {
    name: 'habctl',
    href: '/habctl',
    description: 'Track daily habits with streaks, AI weekly coaching reviews, and habit chains.',
    description_de: 'Tägliche Gewohnheiten mit Streaks tracken, KI-Wochen-Coaching-Reviews und Habit-Chains.',
    mcpCount: 12,
    features: ['Daily check-ins with streaks', 'AI weekly coaching review (Bundle)', 'Habit chains & streak alerts', 'AI habit suggestions (Bundle)'],
    features_de: ['Tägliche Check-ins mit Streaks', 'KI-Wochen-Coaching-Review (Bundle)', 'Habit-Chains & Streak-Warnungen', 'KI-Gewohnheitsvorschläge (Bundle)'],
  },
  {
    name: 'postctl',
    href: 'https://postctl.sh',
    description: 'Schedule social media posts to Threads, Bluesky, Mastodon, and other platforms from your terminal.',
    description_de: 'Social-Media-Posts für Threads, Bluesky, Mastodon und weitere Plattformen direkt aus dem Terminal planen.',
    mcpCount: 7,
    features: ['Threads, Bluesky, Mastodon, X, LinkedIn', 'Safe remote post deletion', 'Spam/ban protection queue', 'MCP tools for AI posting'],
    features_de: ['Threads, Bluesky, Mastodon, X, LinkedIn', 'Sichere Remote-Löschung von Posts', 'Spam-/Sperrschutz-Warteschlange', 'MCP-Tools für KI-Posting'],
  },
];

const mcpConfig = `{
  "mcpServers": {
    "mailctl":   { "command": "mailctl",   "args": ["mcp"] },
    "calctl":    { "command": "calctl",    "args": ["mcp"] },
    "taskctl":   { "command": "taskctl",   "args": ["mcp"] },
    "notectl":   { "command": "notectl",   "args": ["mcp"] },
    "budgetctl": { "command": "budgetctl", "args": ["mcp"] },
    "diaryctl":  { "command": "diaryctl",  "args": ["mcp"] },
    "timectl":   { "command": "timectl",   "args": ["mcp"] },
    "habctl":    { "command": "habctl",    "args": ["mcp"] },
    "postctl":   { "command": "postctl",   "args": ["mcp"] }
  }
}`;

const workflows = [
  {
    title_en: 'Morning Briefing',
    title_de: 'Morning Briefing',
    cmd: 'AI + mailctl + calctl + taskctl',
    description_en: "AI reads your unread emails, checks today's calendar, and surfaces the 3 most important tasks — in one prompt.",
    description_de: 'Die KI liest deine ungelesenen E-Mails, prüft den heutigen Kalender und zeigt die 3 wichtigsten Aufgaben — in einem einzigen Prompt.',
  },
  {
    title_en: 'Weekly Planning',
    title_de: 'Wochenplanung',
    cmd: 'AI + calctl + taskctl + notectl',
    description_en: 'AI reviews your weekly notes, finds free slots, and drafts a prioritized task list synced to Apple Reminders.',
    description_de: 'Die KI durchsucht deine Wochennotizen, findet freie Zeitfenster und erstellt eine priorisierte Aufgabenliste, synchronisiert mit Apple Erinnerungen.',
  },
  {
    title_en: 'Monthly Finance Review',
    title_de: 'Monatlicher Finanz-Review',
    cmd: 'AI + budgetctl',
    description_en: 'Import your bank CSV, let AI categorize transactions and surface anomalies, then write a summary to your Obsidian vault.',
    description_de: 'Importiere deine Bank-CSV, lass die KI Transaktionen kategorisieren und Auffälligkeiten aufzeigen, und schreibe eine Zusammenfassung in deinen Obsidian-Vault.',
  },
  {
    title_en: 'End-of-Day Digest',
    title_de: 'Tagesabschluss-Digest',
    cmd: 'AI + diaryctl + timectl + habctl',
    description_en: 'AI checks your time log, habit streaks, and git commits, then writes a diary entry and surfaces what to finish before tomorrow.',
    description_de: 'Die KI prüft dein Zeitprotokoll, Habit-Streaks und Git-Commits, schreibt einen Tagebucheintrag und zeigt, was bis morgen noch zu erledigen ist.',
  },
];

// Tool grid data
const toolGroups = [
  {
    app: 'mailctl', count: 6, color: '#00d97e',
    tools: [
      { name: 'inbox',      desc: 'List recent inbox messages with sender, subject, preview' },
      { name: 'search_email', desc: 'Search by keyword across subject, sender, body' },
      { name: 'email_thread', desc: 'Get all messages in a thread matched by subject' },
      { name: 'send_email', desc: 'Send an email via Apple Mail' },
      { name: 'draft_email', desc: 'Save a composed message to Apple Mail Drafts' },
      { name: 'sync_inbox', desc: 'Sync from Apple Mail into local cache' },
    ],
  },
  {
    app: 'calctl', count: 7, color: '#6366f1',
    tools: [
      { name: 'list_events',     desc: 'List events between two dates' },
      { name: 'today',           desc: "Today's events" },
      { name: 'this_week',       desc: "This week's events (Monday to Sunday)" },
      { name: 'find_free_slots', desc: 'Find free time within working hours' },
      { name: 'create_event',    desc: 'Create a calendar event' },
      { name: 'delete_event',    desc: 'Delete an event by title and date' },
      { name: 'sync',            desc: 'Sync from Apple Calendar into local cache' },
    ],
  },
  {
    app: 'taskctl', count: 7, color: '#f59e0b',
    tools: [
      { name: 'today_tasks', desc: 'Tasks due today or overdue' },
      { name: 'week_tasks',  desc: 'Tasks due this week' },
      { name: 'list_tasks',  desc: 'List tasks, filter by list or status' },
      { name: 'sync',        desc: 'Sync from Apple Reminders into local cache' },
      { name: 'create_task', desc: 'Create task with title, list, due date, notes' },
      { name: 'complete_task', desc: 'Mark a task completed' },
      { name: 'delete_task', desc: 'Delete a task' },
    ],
  },
  {
    app: 'notectl', count: 7, color: '#a78bfa',
    tools: [
      { name: 'list_notes',      desc: 'List notes from cache (filter: folder, source)' },
      { name: 'read_note',       desc: 'Read full note content by title' },
      { name: 'write_note',      desc: 'Create or update a note in the vault' },
      { name: 'search_notes',    desc: 'Keyword search across title and content' },
      { name: 'sync_notes',      desc: 'Sync Obsidian vault into cache' },
      { name: 'get_daily_note',  desc: "Get today's daily note (creates from template if missing)" },
      { name: 'append_daily_note', desc: 'Append content under a named section' },
    ],
  },
  {
    app: 'budgetctl', count: 11, color: '#10b981',
    tools: [
      { name: 'list_transactions', desc: 'List transactions, filter by month/category/query' },
      { name: 'add_transaction',   desc: 'Add a manual income or expense entry' },
      { name: 'delete_transaction', desc: 'Delete a transaction by its ID' },
      { name: 'import_transactions', desc: 'Import from a bank CSV file' },
      { name: 'budget_summary',    desc: 'Monthly income/expenses/net with category breakdown' },
      { name: 'tag_transactions',  desc: 'Create a category rule (pattern → category)' },
      { name: 'apply_category_rules', desc: 'Re-apply all rules to all transactions' },
      { name: 'list_budget_goals', desc: 'Goals with current-month spending progress' },
      { name: 'set_budget_goal',   desc: 'Set a monthly spending limit for a category' },
      { name: 'delete_budget_goal', desc: 'Remove a goal' },
      { name: 'detect_recurring_payments', desc: 'Detect subscriptions and recurring charges' },
    ],
  },
  {
    app: 'diaryctl', count: 5, color: '#f59e0b',
    tools: [
      { name: 'get_today_stats',    desc: 'Git commits, files changed, suite data (tasks, events, time tracked) for today' },
      { name: 'get_diary_entry',    desc: 'Read a diary entry by date (default: today)' },
      { name: 'write_diary_entry',  desc: 'Save or overwrite a diary entry — used by Claude to fill in the narrative' },
      { name: 'get_coding_stats',   desc: 'Aggregate stats for last N days: streak, commits, most active day, repo breakdown' },
      { name: 'list_diary_entries', desc: 'List recent entries with date and preview' },
    ],
  },
  {
    app: 'timectl', count: 4, color: '#6366f1',
    tools: [
      { name: 'start_timer',    desc: 'Start a timer with task name and optional project tag' },
      { name: 'stop_timer',     desc: 'Stop the running timer, returns task name and duration' },
      { name: 'get_time_log',   desc: 'Time entries for a date or date range with total duration' },
      { name: 'get_time_stats', desc: 'Breakdown by task/project, daily average, streak for last N days' },
