  .faq-question:hover { color: #00d97e; }
  .faq-icon {
    font-size: 1.1rem;
    color: rgba(0,217,126,0.6);
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    transition: transform 0.25s;
    line-height: 1;
  }
  .faq-item.open .faq-icon { transform: rotate(45deg); }
  .faq-answer-text {
    padding: 0 1.25rem 1.1rem;
    color: #718096;
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  // ── Hero background: mouse parallax + scroll drift on the blobs ──
  (() => {
    const section = document.getElementById('hero-section');
    const blobA = section?.querySelector<HTMLElement>('.hero-blob-a');
    const blobB = section?.querySelector<HTMLElement>('.hero-blob-b');
    if (!section || !blobA || !blobB) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    let targetPx = 0, targetPy = 0;
    let curPx = 0, curPy = 0;
    let scrollShift = 0;

    section.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      const nx = (e.clientX - rect.left) / rect.width;   // 0..1
      const ny = (e.clientY - rect.top) / rect.height;   // 0..1
      targetPx = (nx - 0.5) * 2; // -1..1
      targetPy = (ny - 0.5) * 2;
    }, { passive: true });

    function onScroll() {
      const rect = section.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height)));
      scrollShift = progress * 40; // px of upward drift as the hero scrolls away
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function tick() {
      curPx += (targetPx - curPx) * 0.05;
      curPy += (targetPy - curPy) * 0.05;

      blobA.style.transform = `translate3d(${curPx * 14}px, ${curPy * 12 - scrollShift}px, 0)`;
      blobB.style.transform = `translate3d(${curPx * -18}px, ${curPy * -16 - scrollShift * 1.3}px, 0)`;

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();

  // ── Typewriter animation ────────────────────────────────────
  interface Segment { text: string; color?: string; blink?: boolean; }

  const lines: Segment[][] = [
    [{ text: '$ ', color: '#4a5568' }, { text: 'mailctl sync && taskctl today', color: '#e2e8f0' }],
    [{ text: '✓', color: '#00d97e' }, { text: ' Synced 12 messages', color: '#a0aec0' }],
    [{ text: '✓', color: '#00d97e' }, { text: ' 3 tasks due today', color: '#a0aec0' }],
    [],
    [{ text: '$ ', color: '#4a5568' }, { text: 'calctl free ', color: '#e2e8f0' }, { text: '--from', color: '#6366f1' }, { text: ' today ', color: '#e2e8f0' }, { text: '--to', color: '#6366f1' }, { text: ' +7d', color: '#e2e8f0' }],
    [{ text: 'Free slots:', color: '#a0aec0' }],
    [{ text: '  Mon', color: '#f59e0b' }, { text: ' 09:00–11:00', color: '#e2e8f0' }],
    [{ text: '  Wed', color: '#f59e0b' }, { text: ' 14:00–16:00', color: '#e2e8f0' }],
    [],
    [{ text: '$ ', color: '#4a5568' }, { text: 'budgetctl summary ', color: '#e2e8f0' }, { text: '--month', color: '#6366f1' }, { text: ' 2026-07', color: '#e2e8f0' }],
    [{ text: 'Income:   ', color: '#a0aec0' }, { text: '€4,200.00', color: '#00d97e' }],
    [{ text: 'Expenses: ', color: '#a0aec0' }, { text: '€2,847.35', color: '#ef4444' }],
    [{ text: 'Saved:    ', color: '#a0aec0' }, { text: '€1,352.65 (32.2%)', color: '#00d97e' }, { text: '█', color: '#00d97e', blink: true }],
  ];

  function runTypewriter(pre: HTMLElement) {
    // Clear initial cursor placeholder
    pre.innerHTML = '';

    let lineIdx = 0, segIdx = 0, charIdx = 0;
    let currentSpan: HTMLElement | null = null;

    function typeNext() {
      if (lineIdx >= lines.length) return;

      const line = lines[lineIdx];

      if (line.length === 0) {
        pre.appendChild(document.createTextNode('\n'));
        lineIdx++;
        segIdx = 0; charIdx = 0;
        setTimeout(typeNext, 320 + Math.random() * 180);
        return;
      }

      if (segIdx >= line.length) {
        pre.appendChild(document.createTextNode('\n'));
        lineIdx++;
        segIdx = 0; charIdx = 0;
        currentSpan = null;
        setTimeout(typeNext, 280 + Math.random() * 200);
        return;
      }

      const seg = line[segIdx];

      if (charIdx === 0) {
        currentSpan = document.createElement('span');
        if (seg.color) currentSpan.style.color = seg.color;
        if (seg.blink) currentSpan.className = 'cursor-blink';
        pre.appendChild(currentSpan);
      }

      if (currentSpan) currentSpan.textContent += seg.text[charIdx];
      charIdx++;

      if (charIdx >= seg.text.length) {
        segIdx++; charIdx = 0; currentSpan = null;
      }

      setTimeout(typeNext, 28 + Math.random() * 22);
    }

    typeNext();
  }

  // Start when terminal enters viewport
  const terminal = document.getElementById('hero-terminal');
  const pre = terminal?.querySelector('pre');

  if (pre) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          obs.disconnect();
          setTimeout(() => runTypewriter(pre as HTMLElement), 400);
        }
      },
      { threshold: 0.3 }
    );
    obs.observe(terminal!);
  }

  // ── FAQ accordion ───────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('.faq-item');
      if (!item) return;
      const wasOpen = item.classList.contains('open');
      // Close all
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        const q = i.querySelector('.faq-question');
        if (q) q.setAttribute('aria-expanded', 'false');
      });
      // Toggle clicked
      if (!wasOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Stat count-up ───────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.stat-num').forEach(el => {
    const target = parseInt(el.dataset.count || '0', 10);
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        el.textContent = '0';
        const duration = 900;
        const start = performance.now();
        function tick(now: number) {
          const p = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        }
        requestAnimationFrame(tick);
      },
      { threshold: 0.5 }
    );
    obs.observe(el);
  });
</script>
