];

const faqs = [
  {
    q_en: 'Do I need a Claude subscription?',
    q_de: 'Brauche ich ein Claude-Abo?',
    a_en: 'Yes, Claude Pro or Team. missionctl connects to Claude Desktop via MCP — no extra subscription needed beyond that.',
    a_de: 'Ja, Claude Pro oder Team. missionctl verbindet sich per MCP mit Claude Desktop — darüber hinaus ist kein zusätzliches Abo nötig.',
  },
  {
    q_en: 'Does it work on Linux?',
    q_de: 'Funktioniert es unter Linux?',
    a_en: 'notectl, budgetctl, diaryctl, timectl, and habctl work on macOS and Linux. mailctl, calctl, and taskctl require macOS (they bridge Apple Mail, Calendar, and Reminders).',
    a_de: 'notectl, budgetctl, diaryctl, timectl und habctl laufen unter macOS und Linux. mailctl, calctl und taskctl benötigen macOS (sie binden Apple Mail, Kalender und Erinnerungen an).',
  },
  {
    q_en: 'Is my data safe?',
    q_de: 'Sind meine Daten sicher?',
    a_en: 'All data stays on your machine. missionctl never calls any external server. The only network calls are what you explicitly trigger (sending an email, publishing a post).',
    a_de: 'Alle Daten bleiben auf deinem Rechner. missionctl ruft niemals einen externen Server auf. Die einzigen Netzwerkaufrufe sind die, die du explizit auslöst (eine E-Mail senden, einen Post veröffentlichen).',
  },
  {
    q_en: "What if Apple Mail/Calendar isn't running?",
    q_de: 'Was, wenn Apple Mail/Kalender nicht läuft?',
    a_en: 'mailctl and calctl launch Apple Mail and Calendar in the background via AppleScript if they aren\'t open. No manual intervention needed.',
    a_de: 'mailctl und calctl starten Apple Mail und Kalender bei Bedarf automatisch im Hintergrund per AppleScript. Kein manuelles Eingreifen nötig.',
  },
  {
    q_en: 'Can I use it without the TUI?',
    q_de: 'Kann ich es ohne die TUI nutzen?',
    a_en: 'Yes. Every tool has a full CLI (mailctl inbox --json, taskctl today, etc.). The TUI is the default but optional.',
    a_de: 'Ja. Jedes Tool hat eine vollständige CLI (mailctl inbox --json, taskctl today, usw.). Die TUI ist Standard, aber optional.',
  },
  {
    q_en: 'How do I get updates?',
    q_de: 'Wie bekomme ich Updates?',
    a_en: 'Updates are free. Run brew upgrade <tool>, or pull the latest from GitHub and re-run ./setup.sh.',
    a_de: 'Updates sind kostenlos. Führe brew upgrade <tool> aus, oder hole dir den neuesten Stand von GitHub und führe ./setup.sh erneut aus.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q_en,
    acceptedAnswer: { '@type': 'Answer', text: f.a_en },
  })),
};
---

<Layout
  title="missionctl — Give your AI hands"
  description="66 MCP tools, 9 local-first terminal apps. Email, calendar, tasks, notes, budget, habits, time, diary, and social posts. No subscriptions."
>
  <!-- ======= HERO ======= -->
  <section style="position: relative; min-height: calc(100vh - 92px); display: flex; flex-direction: column; justify-content: center; padding: 10rem 1.5rem 6rem; max-width: 1200px; margin: 0 auto;" id="hero-section">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-blob hero-blob-a"></div>
      <div class="hero-blob hero-blob-b"></div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; position: relative; z-index: 1;" class="hero-grid">

      <!-- Left: Text -->
      <div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #00d97e; margin-bottom: 1rem; letter-spacing: 0.1em; text-transform: uppercase;">
          <span class="lang-en">66 MCP tools &middot; 9 terminal apps &middot; macOS + Linux</span><span class="lang-de">66 MCP-Tools &middot; 9 Terminal-Apps &middot; macOS + Linux</span>
        </div>
        <h1 style="font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 900; line-height: 1.08; letter-spacing: -0.03em; color: #e2e8f0; margin: 0 0 1.25rem;">
          <span class="lang-en">Give your AI<br><span style="color: #00d97e; text-shadow: 0 0 40px rgba(0,217,126,0.3);">hands.</span></span>
          <span class="lang-de">Gib deiner KI<br><span style="color: #00d97e; text-shadow: 0 0 40px rgba(0,217,126,0.3);">Hände.</span></span>
        </h1>
        <p style="font-size: 1.125rem; color: #718096; line-height: 1.65; margin: 0 0 2rem; max-width: 480px;">
          <span class="lang-en">66 MCP tools across 9 terminal apps. Local-first. No subscriptions.
          Your AI can now read email, manage your calendar, handle tasks, write notes, track spending, log time, track habits, keep a diary, and schedule posts.</span>
          <span class="lang-de">66 MCP-Tools über 9 Terminal-Apps. Local-first. Keine Abos.
          Deine KI kann jetzt E-Mails lesen, deinen Kalender verwalten, Aufgaben erledigen, Notizen schreiben, Ausgaben verfolgen, Zeit erfassen, Gewohnheiten tracken, Tagebuch führen und Posts planen.</span>
        </p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a
            href="#pricing"
            style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.5rem; background: #00d97e; color: #0a0a0f; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: all 0.15s ease; box-shadow: 0 4px 20px rgba(0,217,126,0.2);"
            class="hero-cta-primary"
          >
            <span class="lang-en">Download &mdash; Free</span><span class="lang-de">Herunterladen &mdash; Kostenlos</span>
          </a>
          <a
            href="#apps"
            style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.5rem; background: transparent; color: #e2e8f0; border-radius: 6px; border: 1px solid #1e1e2e; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.15s ease;"
            class="hero-cta-secondary"
          >
            <span class="lang-en">Browse Apps &darr;</span><span class="lang-de">Apps ansehen &darr;</span>
          </a>
        </div>
        <p style="color: #4a5568; font-size: 0.75rem; margin: 1.25rem 0 0; font-family: 'JetBrains Mono', monospace;">
          <span class="lang-en">MIT licensed &middot; Free core, Bundle unlocks more &middot; Your data stays on your machine</span><span class="lang-de">MIT-lizenziert &middot; Kostenloser Kern, Bundle schaltet mehr frei &middot; Deine Daten bleiben auf deinem Rechner</span>
        </p>
      </div>

      <!-- Right: Terminal (typewriter) -->
      <div>
        <TerminalWindow id="hero-terminal" title="~ missionctl" content={`<span class="cursor-blink" style="color:#00d97e">&#x2588;</span>`} />
      </div>

    </div>
  </section>

  <!-- ======= THE IDEA ======= -->
  <section style="padding: 5rem 1.5rem; background: #111118; border-top: 1px solid #1e1e2e; border-bottom: 1px solid #1e1e2e;">
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: #e2e8f0; margin: 0 0 1rem; letter-spacing: -0.02em;">
        <span class="lang-en">AI is great at planning.<br><span style="color: #718096;">It's bad at doing — because it has no hands.</span></span>
        <span class="lang-de">KI ist großartig im Planen.<br><span style="color: #718096;">Schlecht im Tun — weil sie keine Hände hat.</span></span>
      </h2>
      <p style="color: #718096; font-size: 1rem; line-height: 1.7; max-width: 600px; margin: 0 auto;">
        <span class="lang-en">missionctl gives your AI hands. Each app runs locally on your machine and exposes MCP tools that Claude (or any MCP client) can call directly — no cloud, no subscriptions, no data leaving your computer.</span>
        <span class="lang-de">missionctl gibt deiner KI Hände. Jede App läuft lokal auf deinem Rechner und stellt MCP-Tools bereit, die Claude (oder jeder andere MCP-Client) direkt aufrufen kann — keine Cloud, keine Abos, keine Daten verlassen deinen Rechner.</span>
      </p>
    </div>
  </section>

  <!-- ======= HOW IT WORKS ======= -->
  <section style="padding: 5rem 1.5rem; max-width: 1200px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: #e2e8f0; margin: 0 0 0.75rem; letter-spacing: -0.02em;">
        <span class="lang-en">How it works</span><span class="lang-de">So funktioniert's</span>
      </h2>
      <p style="color: #718096; font-size: 1rem; max-width: 500px; margin: 0 auto;">
        <span class="lang-en">AI plans. missionctl executes. Your data stays local.</span><span class="lang-de">KI plant. missionctl führt aus. Deine Daten bleiben lokal.</span>
      </p>
    </div>

    <!-- Steps -->
    <div style="display: flex; align-items: stretch; justify-content: center; gap: 0; flex-wrap: wrap;" class="how-steps">

      <!-- Step 1 -->
      <div class="how-card">
        <div class="how-step-num">01</div>
        <h3 class="how-title"><span class="lang-en">You ask Claude</span><span class="lang-de">Du fragst Claude</span></h3>
        <p class="how-desc">
          <span class="lang-en">"Give me a morning briefing"<br>"Schedule a launch campaign"</span>
          <span class="lang-de">"Gib mir ein Morning Briefing"<br>"Plane eine Launch-Kampagne"</span>
        </p>
      </div>

      <div class="how-arrow">──&rarr;</div>

      <!-- Step 2 -->
      <div class="how-card how-card--accent">
        <div class="how-step-num">02</div>
