            <td style="padding: 0.5rem 0.75rem; color:var(--color-terminal-dim); font-family:'JetBrains Mono',monospace; white-space:nowrap;">MAILCTL_OLLAMA_MODEL</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-terminal-border);">
