      { href: '#calctl', label_en: 'calctl', label_de: 'calctl' },
      { href: '#taskctl', label_en: 'taskctl', label_de: 'taskctl' },
      { href: '#notectl', label_en: 'notectl', label_de: 'notectl' },
      { href: '#budgetctl', label_en: 'budgetctl', label_de: 'budgetctl' },
      { href: '#diaryctl', label_en: 'diaryctl', label_de: 'diaryctl' },
