---
import Layout from '../components/Layout.astro';

const mcpConfig = `{
  "mcpServers": {
    "mailctl":   { "command": "mailctl",   "args": ["mcp"] },
    "calctl":    { "command": "calctl",    "args": ["mcp"] },
    "taskctl":   { "command": "taskctl",   "args": ["mcp"] },
    "notectl":   { "command": "notectl",   "args": ["mcp"] },
    "budgetctl": { "command": "budgetctl", "args": ["mcp"] },
    "diaryctl":  { "command": "diaryctl",  "args": ["mcp"] },
    "timectl":   { "command": "timectl",   "args": ["mcp"] },
    "habctl":    { "command": "habctl",    "args": ["mcp"] },
    "postctl":   { "command": "postctl",   "args": ["mcp"] }
  }
}`;

const navSections = [
  {
    title_en: 'Getting Started',
    title_de: 'Erste Schritte',
    links: [
      { href: '#installation', label_en: 'Installation', label_de: 'Installation' },
      { href: '#quick-setup', label_en: 'Quick Setup', label_de: 'Schnelleinrichtung' },
      { href: '#claude-config', label_en: 'Claude Desktop config', label_de: 'Claude-Desktop-Konfiguration' },
      { href: '#sync-across-devices', label_en: 'Sync across devices', label_de: 'Sync über mehrere Geräte' },
      { href: '#licensing', label_en: 'Licensing (Bundle features)', label_de: 'Lizenzierung (Bundle-Features)' },
      { href: '#local-ai', label_en: 'Local AI with Ollama', label_de: 'Lokale KI mit Ollama' },
      { href: '#tutorial', label_en: 'Tutorial: first 10 minutes', label_de: 'Tutorial: die ersten 10 Minuten' },
    ],
  },
  {
    title_en: 'Tools',
    title_de: 'Tools',
    links: [
      { href: '#mailctl', label_en: 'mailctl', label_de: 'mailctl' },
      { href: '#calctl', label_en: 'calctl', label_de: 'calctl' },
      { href: '#taskctl', label_en: 'taskctl', label_de: 'taskctl' },
      { href: '#notectl', label_en: 'notectl', label_de: 'notectl' },
      { href: '#budgetctl', label_en: 'budgetctl', label_de: 'budgetctl' },
      { href: '#diaryctl', label_en: 'diaryctl', label_de: 'diaryctl' },
      { href: '#timectl', label_en: 'timectl', label_de: 'timectl' },
      { href: '#habctl', label_en: 'habctl', label_de: 'habctl' },
      { href: '#postctl', label_en: 'postctl', label_de: 'postctl' },
    ],
  },
  {
    title_en: 'Reference',
    title_de: 'Referenz',
    links: [
      { href: '#mcp-reference', label_en: 'MCP Reference', label_de: 'MCP-Referenz' },
      { href: '#ai-workflows', label_en: 'AI Workflows', label_de: 'KI-Workflows' },
    ],
  },
