---
import Layout from '../components/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const mcpTools = [
  { name: "list_transactions", desc: "List transactions, filter by month, category, or search term" },
  { name: "add_transaction", desc: "Add a manual income or expense entry" },
  { name: "delete_transaction", desc: "Delete a transaction by its ID" },
  { name: "import_transactions", desc: "Import transactions from a bank CSV file (N26, ING, DKB, generic)" },
  { name: "budget_summary", desc: "Monthly income/expense summary with category breakdown" },
  { name: "tag_transactions", desc: "Create a category rule — matching transactions get auto-tagged" },
  { name: "apply_category_rules", desc: "Re-apply all saved category rules to every transaction" },
  { name: "list_budget_goals", desc: "List budget goals with current-month spending progress" },
  { name: "set_budget_goal", desc: "Set or update a monthly spending limit for a category" },
  { name: "delete_budget_goal", desc: "Remove a budget goal for a category" },
  { name: "detect_recurring_payments", desc: "Scan transactions for recurring payment patterns (missionctl Bundle)" },
];
const features = [
  { title: "Bank CSV Import", title_de: "Bank-CSV-Import", desc: "Import CSV exports from N26, ING, DKB, and other banks. Auto-detects the format and maps columns.", desc_de: "Importiere CSV-Exporte von N26, ING, DKB und anderen Banken. Erkennt das Format automatisch und ordnet Spalten zu." },
  { title: "Category Rules", title_de: "Kategorie-Regeln", desc: "Define regex-based categorization rules. Transactions are auto-categorized on import. Rules persist in SQLite.", desc_de: "Definiere Regex-basierte Kategorisierungsregeln. Transaktionen werden beim Import automatisch kategorisiert. Regeln bleiben dauerhaft in SQLite gespeichert." },
  { title: "AI Categorization (Bundle)", title_de: "KI-Kategorisierung (Bundle)", desc: "Import with --ai and your configured AI provider (Anthropic, OpenAI, Gemini, or local Ollama — no cost) categorizes uncategorized transactions for you. Unlocks with the missionctl Bundle.", desc_de: "Importiere mit --ai und dein konfigurierter KI-Anbieter (Anthropic, OpenAI, Gemini oder lokales Ollama — kostenlos) kategorisiert unkategorisierte Transaktionen für dich. Schaltet mit dem missionctl-Bundle frei." },
  { title: "Budget Goals", title_de: "Budgetziele", desc: "Set monthly spending limits per category. Visual progress bars show how you're tracking against each goal.", desc_de: "Setze monatliche Ausgabenlimits pro Kategorie. Visuelle Fortschrittsbalken zeigen, wie du im Vergleich zu jedem Ziel liegst." },
  { title: "Profiles", title_de: "Profile", desc: "Keep contexts fully separate — a business account and your personal accounts each get their own database. Switch with budgetctl profile use or the TUI's p key.", desc_de: "Halte Kontexte vollständig getrennt — ein Geschäftskonto und deine privaten Konten bekommen jeweils eine eigene Datenbank. Wechsle mit budgetctl profile use oder der p-Taste im TUI." },
  { title: "Recurring Detection (Bundle)", title_de: "Erkennung wiederkehrender Zahlungen (Bundle)", desc: "Automatically detect recurring payments (subscriptions, rent, utilities) based on transaction patterns. Unlocks with the missionctl Bundle.", desc_de: "Erkennt automatisch wiederkehrende Zahlungen (Abos, Miete, Nebenkosten) anhand von Transaktionsmustern. Schaltet mit dem missionctl-Bundle frei." },
  { title: "Command Palette", title_de: "Befehlspalette", desc: "Press \":\" and type an action by name — new entry, import CSV, summary — instead of memorizing shortcuts. Live-filtered as you type.", desc_de: "Drücke \":\" und tippe eine Aktion nach Namen — neuer Eintrag, CSV-Import, Übersicht — statt Shortcuts auswendig zu lernen. Filtert live beim Tippen." },
];
---

<Layout
  title="budgetctl — Budget tracking from your Terminal"
  description="budgetctl — Import bank CSVs, categorize transactions, track budget goals. Works on macOS and Linux. 11 MCP tools for Claude Desktop."
  type="software"
  appName="budgetctl"
>
  <!-- HERO -->
  <section style="padding: 10rem 1.5rem 5rem; max-width: 1100px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;" class="hero-grid">
      <div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #10b981; margin-bottom: 1rem; letter-spacing: 0.1em; text-transform: uppercase;">
          missionctl suite &middot; macOS &amp; Linux
        </div>
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; color: var(--color-terminal-text); margin: 0 0 1rem;">
          <span style="font-family: 'JetBrains Mono', monospace; color: #10b981;">budgetctl</span>
        </h1>
        <p style="font-size: 1.25rem; font-weight: 600; color: var(--color-terminal-text); margin: 0 0 0.75rem;"><span class="lang-en">Budget tracking from your Terminal</span><span class="lang-de">Budgetverfolgung aus deinem Terminal</span></p>
        <p style="color: var(--color-terminal-dim); font-size: 1rem; line-height: 1.65; margin: 0 0 2rem;"><span class="lang-en">Import bank CSV files, categorize transactions, and set budget goals — free. AI categorization and recurring-payment detection unlock with the Bundle. Works on macOS and Linux. 11 MCP tools.</span><span class="lang-de">Bank-CSV-Dateien importieren, Transaktionen kategorisieren und Budgetziele setzen — kostenlos. KI-Kategorisierung und Erkennung wiederkehrender Zahlungen schaltet das Bundle frei. Läuft unter macOS und Linux. 11 MCP-Tools.</span></p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="https://github.com/aeon022/budgetctl/releases/latest" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; background: #10b981; color: var(--color-terminal-bg); border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: all 0.15s;"
            class="cta-primary">
            <span class="lang-en">Download &mdash; Free</span><span class="lang-de">Herunterladen &mdash; Kostenlos</span>
          </a>
          <a href="https://buy.polar.sh/polar_cl_kf5owZpIIKKtLjfO6wU3ofmYHecAixqxVZrmr1GMGOd" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; background: transparent; color: var(--color-terminal-text); border-radius: 6px; border: 1px solid var(--color-terminal-border); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.15s;"
            class="cta-secondary">
            <span class="lang-en">Get the Bundle &mdash; $39</span><span class="lang-de">Bundle holen &mdash; $39</span>
          </a>
          <a href="https://buy.polar.sh/polar_cl_ARkg3wm2qsOAiv9PpGlw8cDBO00krDbAlm8QL2wg0gK" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; color: var(--color-terminal-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none;">
            <span class="lang-en">Unlock AI features &mdash; $9 (-30% w/ L4uNch26)</span><span class="lang-de">KI-Features freischalten &mdash; $9 (-30% mit L4uNch26)</span>
          </a>
        </div>
      </div>
      <div>
        <TerminalWindow title="budgetctl — monthly summary" content={`<span style="color:var(--color-terminal-muted)">$ </span>budgetctl summary --month 2026-07

<span style="color:var(--color-terminal-code-text)">July 2026</span>
<span style="color:var(--color-terminal-muted)">&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;</span>
<span style="color:var(--color-terminal-code-text)">Income      </span><span style="color:#10b981">+&#x20ac;4,200.00</span>
<span style="color:var(--color-terminal-code-text)">Expenses    </span><span style="color:#ef4444">-&#x20ac;2,847.35</span>
<span style="color:var(--color-terminal-code-text)">Saved       </span><span style="color:#10b981">+&#x20ac;1,352.65</span>

<span style="color:var(--color-terminal-code-text)">Top categories:</span>
  <span style="color:#f59e0b">Housing</span>       <span style="color:var(--color-terminal-text)">&#x20ac;1,200</span>  <span style="color:var(--color-terminal-muted)">42%</span>
  <span style="color:#f59e0b">Food</span>          <span style="color:var(--color-terminal-text)">&#x20ac;487</span>   <span style="color:var(--color-terminal-muted)">17%</span>
  <span style="color:#f59e0b">Transport</span>     <span style="color:var(--color-terminal-text)">&#x20ac;243</span>   <span style="color:var(--color-terminal-muted)">9%</span>

<span style="color:#10b981">&#x2713;</span> <span style="color:var(--color-terminal-muted)">3 recurring payments detected</span><span class="cursor-blink" style="color:#10b981">&#x2588;</span>`} />
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section style="padding: 4rem 1.5rem; background: var(--color-terminal-surface); border-top: 1px solid var(--color-terminal-border); border-bottom: 1px solid var(--color-terminal-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 2.5rem; letter-spacing: -0.02em;"><span class="lang-en">Features</span><span class="lang-de">Funktionen</span></h2>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;" class="features-grid">
        {features.map((feat: {title: string; title_de: string; desc: string; desc_de: string}) => (
          <div style="background: var(--color-terminal-bg); border: 1px solid var(--color-terminal-border); border-radius: 8px; padding: 1.5rem; transition: border-color 0.2s;" class="feature-card">
            <h3 style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700; color: #10b981; margin: 0 0 0.5rem;"><span class="lang-en">{feat.title}</span><span class="lang-de">{feat.title_de}</span></h3>
            <p style="color: var(--color-terminal-dim); font-size: 0.875rem; line-height: 1.6; margin: 0;"><span class="lang-en">{feat.desc}</span><span class="lang-de">{feat.desc_de}</span></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHEATSHEET -->
  <section style="padding: 4rem 1.5rem; max-width: 1100px; margin: 0 auto;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 2rem; letter-spacing: -0.02em;"><span class="lang-en">Command Reference</span><span class="lang-de">Befehlsreferenz</span></h2>
    <TerminalWindow title="budgetctl — cheatsheet" content={`<span style="color:var(--color-terminal-muted)"># Import bank CSV</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl import --file n26-export.csv
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl import --file ing-2026-07.csv --bank ing

<span style="color:var(--color-terminal-muted)"># Monthly summary</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl summary --month 2026-07

<span style="color:var(--color-terminal-muted)"># List transactions</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl list --month 2026-07
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl list --category food

<span style="color:var(--color-terminal-muted)"># Set budget goals</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl goal set food 500
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl goal list

<span style="color:var(--color-terminal-muted)"># Categorize a transaction</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl categorize --id 42 --category dining

<span style="color:var(--color-terminal-muted)"># Add a category rule</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl rule add <span style="color:var(--color-terminal-code-text)">"Spotify"</span> entertainment

<span style="color:var(--color-terminal-muted)"># Keep work & personal fully separate</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl profile add firma
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl profile use firma

<span style="color:var(--color-terminal-muted)"># Detect recurring payments</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl recurring

<span style="color:var(--color-terminal-muted)"># Start MCP server</span>
<span style="color:var(--color-terminal-muted)">$ </span>budgetctl mcp`} />
  </section>

  <!-- MCP TOOLS -->
  <section style="padding: 4rem 1.5rem; background: var(--color-terminal-surface); border-top: 1px solid var(--color-terminal-border); border-bottom: 1px solid var(--color-terminal-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 0.5rem; letter-spacing: -0.02em;"><span class="lang-en">MCP Tools</span><span class="lang-de">MCP-Tools</span></h2>
      <p style="color: var(--color-terminal-dim); font-size: 0.875rem; margin: 0 0 2rem;"><span class="lang-en">Available via</span><span class="lang-de">Verfügbar über</span> <code style="font-family: 'JetBrains Mono', monospace; background: var(--color-terminal-bg); padding: 0.1em 0.4em; border-radius: 3px; color: #10b981;">budgetctl mcp</code></p>
      <div style="border: 1px solid var(--color-terminal-border); border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: var(--color-terminal-bg); border-bottom: 1px solid var(--color-terminal-border);">
              <th style="text-align: left; padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--color-terminal-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; width: 35%;"><span class="lang-en">Tool</span><span class="lang-de">Tool</span></th>
              <th style="text-align: left; padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--color-terminal-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;"><span class="lang-en">Description</span><span class="lang-de">Beschreibung</span></th>
            </tr>
          </thead>
          <tbody>
            {mcpTools.map((tool: {name: string; desc: string}, i: number) => (
              <tr style={`background: ${i % 2 === 0 ? 'var(--color-terminal-surface)' : 'var(--color-terminal-code-bg)'}; border-bottom: 1px solid var(--color-terminal-border);`}>
                <td style="padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; word-break: break-word; color: #10b981;">{tool.name}</td>
                <td style="padding: 0.75rem 1.25rem; font-size: 0.875rem; color: var(--color-terminal-dim);">{tool.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 5rem 1.5rem; text-align: center; max-width: 600px; margin: 0 auto;">
    <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 1rem; letter-spacing: -0.02em;"><span class="lang-en">Ready to give your AI hands?</span><span class="lang-de">Bereit, deiner KI Hände zu geben?</span></h2>
    <p style="color: var(--color-terminal-dim); font-size: 1rem; line-height: 1.65; margin: 0 0 2rem;">
      <span class="lang-en">Free and open source. Or get the lifetime Bundle for all 9 tools &mdash; launch special: -30% with code L4uNch26.</span>
      <span class="lang-de">Kostenlos und Open Source. Oder hol dir das Lifetime-Bundle für alle 9 Tools &mdash; Launch-Special: -30% mit Code L4uNch26.</span>
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="https://github.com/aeon022/budgetctl/releases/latest" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; background: #10b981; color: var(--color-terminal-bg); border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: all 0.15s; box-shadow: 0 4px 20px rgba(16,185,129,0.2);"
            class="cta-primary">
            <span class="lang-en">Download &mdash; Free</span><span class="lang-de">Herunterladen &mdash; Kostenlos</span>
          </a>
      <a href="https://buy.polar.sh/polar_cl_kf5owZpIIKKtLjfO6wU3ofmYHecAixqxVZrmr1GMGOd" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; background: transparent; color: var(--color-terminal-text); border-radius: 6px; border: 1px solid var(--color-terminal-border); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.15s;"
            class="cta-secondary">
            <span class="lang-en">Get the Bundle &mdash; $39</span><span class="lang-de">Bundle holen &mdash; $39</span>
          </a>
      <a href="https://buy.polar.sh/polar_cl_ARkg3wm2qsOAiv9PpGlw8cDBO00krDbAlm8QL2wg0gK" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; color: var(--color-terminal-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none;">
            <span class="lang-en">Unlock AI features &mdash; $9 (-30% w/ L4uNch26)</span><span class="lang-de">KI-Features freischalten &mdash; $9 (-30% mit L4uNch26)</span>
          </a>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr !important; }
    .features-grid { grid-template-columns: 1fr !important; }
  }
  .cta-primary:hover { background: #059669 !important; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(16,185,129,0.3) !important; }
  .cta-secondary:hover { border-color: rgba(16,185,129,0.3) !important; color: #10b981 !important; }
  .feature-card:hover { border-color: rgba(16,185,129,0.2) !important; }
</style>
