---
import Layout from '../components/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const mcpTools = [
  { name: "list_events", desc: "List calendar events between two dates, sorted by start time" },
  { name: "today", desc: "List today's calendar events — shortcut for list_events" },
  { name: "this_week", desc: "List this week's calendar events (Monday to Sunday)" },
  { name: "find_free_slots", desc: "Find free time slots within working hours for a date range" },
  { name: "create_event", desc: "Create a new event in Apple Calendar" },
  { name: "delete_event", desc: "Delete a calendar event by title and date" },
  { name: "sync", desc: "Sync events from Apple Calendar into the local cache" },
];
const features = [
  { title: "TUI Week View", title_de: "TUI-Wochenansicht", desc: "Full-featured terminal calendar with week and month views. See all your calendars color-coded in the terminal.", desc_de: "Vollwertiger Terminal-Kalender mit Wochen- und Monatsansichten. Sieh alle deine Kalender farblich codiert im Terminal." },
  { title: "Apple Calendar Sync", title_de: "Apple-Kalender-Sync", desc: "Reads directly from Apple Calendar via EventKit. No third-party calendar access — your data stays local.", desc_de: "Liest direkt aus Apple Kalender über EventKit. Kein Drittanbieter-Zugriff — deine Daten bleiben lokal." },
  { title: "Free Slot Finder", title_de: "Freie-Slot-Finder", desc: "Scan any date range and surface available time blocks across all your calendars. Essential for scheduling.", desc_de: "Durchsuche jeden Zeitraum und finde freie Zeitblöcke über alle deine Kalender hinweg. Essenziell für Terminplanung." },
  { title: "Event Creation", title_de: "Termine erstellen", desc: "Create events from the terminal or via MCP. Supports duration, location, notes, and calendar selection.", desc_de: "Erstelle Termine aus dem Terminal oder via MCP. Unterstützt Dauer, Ort, Notizen und Kalenderauswahl." },
  { title: "AI Meeting Summaries (Bundle)", title_de: "KI-Meeting-Zusammenfassungen (Bundle)", desc: "calctl summarize turns an event into a structured summary — overview, decisions, action items, next steps. Unlocks with the missionctl Bundle.", desc_de: "calctl summarize verwandelt einen Termin in eine strukturierte Zusammenfassung — Überblick, Entscheidungen, Aufgaben, nächste Schritte. Schaltet mit dem missionctl-Bundle frei." },
  { title: "Command Palette", title_de: "Befehlspalette", desc: "Press \":\" and type an action by name — new event, sync, free slots — instead of memorizing shortcuts. Live-filtered as you type.", desc_de: "Drücke \":\" und tippe eine Aktion nach Namen — neuer Termin, Sync, freie Slots — statt Shortcuts auswendig zu lernen. Filtert live beim Tippen." },
];
---

<Layout
  title="calctl — Calendar from your Terminal"
  description="calctl — Browse calendar, create events, find free slots via Apple Calendar. 7 MCP tools for Claude Desktop."
  type="software"
  appName="calctl"
>
  <!-- HERO -->
  <section style="padding: 10rem 1.5rem 5rem; max-width: 1100px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;" class="hero-grid">
      <div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #6366f1; margin-bottom: 1rem; letter-spacing: 0.1em; text-transform: uppercase;">
          missionctl suite &middot; macOS
        </div>
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; color: var(--color-terminal-text); margin: 0 0 1rem;">
          <span style="font-family: 'JetBrains Mono', monospace; color: #6366f1;">calctl</span>
        </h1>
        <p style="font-size: 1.25rem; font-weight: 600; color: var(--color-terminal-text); margin: 0 0 0.75rem;"><span class="lang-en">Calendar from your Terminal</span><span class="lang-de">Kalender aus deinem Terminal</span></p>
        <p style="color: var(--color-terminal-dim); font-size: 1rem; line-height: 1.65; margin: 0 0 2rem;"><span class="lang-en">Browse calendar, create events, and find free slots via Apple Calendar. 7 MCP tools for AI-powered scheduling.</span><span class="lang-de">Kalender durchsuchen, Termine erstellen und freie Slots finden über Apple Kalender. 7 MCP-Tools für KI-gestützte Terminplanung.</span></p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="https://github.com/aeon022/calctl/releases/latest" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; background: #6366f1; color: var(--color-terminal-bg); border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: all 0.15s;"
            class="cta-primary">
            <span class="lang-en">Download &mdash; Free</span><span class="lang-de">Herunterladen &mdash; Kostenlos</span>
          </a>
          <a href="https://buy.polar.sh/polar_cl_kf5owZpIIKKtLjfO6wU3ofmYHecAixqxVZrmr1GMGOd" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; background: transparent; color: var(--color-terminal-text); border-radius: 6px; border: 1px solid var(--color-terminal-border); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.15s;"
            class="cta-secondary">
            <span class="lang-en">Get the Bundle &mdash; $39</span><span class="lang-de">Bundle holen &mdash; $39</span>
          </a>
          <a href="https://buy.polar.sh/polar_cl_FVeOLZeCaEh8wYJiRL6xifwn3VDvkt4KGjipA3u479F" target="_blank" rel="noopener"
            style="display: inline-flex; align-items: center; padding: 0.75rem 1.25rem; color: var(--color-terminal-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none;">
            <span class="lang-en">Unlock AI features &mdash; $9 (-30% w/ L4uNch26)</span><span class="lang-de">KI-Features freischalten &mdash; $9 (-30% mit L4uNch26)</span>
          </a>
        </div>
      </div>
      <div>
        <TerminalWindow title="calctl — free slots" content={`<span style="color:var(--color-terminal-muted)">$ </span>calctl free --from today --to friday
<span style="color:var(--color-terminal-code-text)">Scanning: Work, Personal, Shared</span>

<span style="color:var(--color-terminal-code-text)">Free slots this week:</span>
  <span style="color:#f59e0b">Mon</span>  <span style="color:#6366f1">09:00-11:00</span>  <span style="color:var(--color-terminal-muted)">2h</span>
  <span style="color:#f59e0b">Mon</span>  <span style="color:#6366f1">14:30-17:00</span>  <span style="color:var(--color-terminal-muted)">2h30m</span>
  <span style="color:#f59e0b">Wed</span>  <span style="color:#6366f1">10:00-12:00</span>  <span style="color:var(--color-terminal-muted)">2h</span>
  <span style="color:#f59e0b">Fri</span>  <span style="color:#6366f1">13:00-17:00</span>  <span style="color:var(--color-terminal-muted)">4h</span>

<span style="color:var(--color-terminal-muted)">$ </span>calctl add <span style="color:var(--color-terminal-code-text)">"Team sync"</span> --start <span style="color:var(--color-terminal-code-text)">"Mon 10:00"</span> --dur 1h
<span style="color:#6366f1">&#x2713;</span> <span style="color:var(--color-terminal-code-text)">Created in Apple Calendar</span><span class="cursor-blink" style="color:#6366f1">&#x2588;</span>`} />
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section style="padding: 4rem 1.5rem; background: var(--color-terminal-surface); border-top: 1px solid var(--color-terminal-border); border-bottom: 1px solid var(--color-terminal-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 2.5rem; letter-spacing: -0.02em;"><span class="lang-en">Features</span><span class="lang-de">Funktionen</span></h2>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;" class="features-grid">
        {features.map((feat: {title: string; title_de: string; desc: string; desc_de: string}) => (
          <div style="background: var(--color-terminal-bg); border: 1px solid var(--color-terminal-border); border-radius: 8px; padding: 1.5rem; transition: border-color 0.2s;" class="feature-card">
            <h3 style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700; color: #6366f1; margin: 0 0 0.5rem;"><span class="lang-en">{feat.title}</span><span class="lang-de">{feat.title_de}</span></h3>
            <p style="color: var(--color-terminal-dim); font-size: 0.875rem; line-height: 1.6; margin: 0;"><span class="lang-en">{feat.desc}</span><span class="lang-de">{feat.desc_de}</span></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHEATSHEET -->
  <section style="padding: 4rem 1.5rem; max-width: 1100px; margin: 0 auto;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 2rem; letter-spacing: -0.02em;"><span class="lang-en">Command Reference</span><span class="lang-de">Befehlsreferenz</span></h2>
    <TerminalWindow title="calctl — cheatsheet" content={`<span style="color:var(--color-terminal-muted)"># Show today's events</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl today

<span style="color:var(--color-terminal-muted)"># Week view (TUI)</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl week

<span style="color:var(--color-terminal-muted)"># Find free slots</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl free --from today --to +7d
<span style="color:var(--color-terminal-muted)">$ </span>calctl free --from today --to friday --min-dur 2h

<span style="color:var(--color-terminal-muted)"># List events for a date</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl list --date 2026-07-10

<span style="color:var(--color-terminal-muted)"># Create event</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl add <span style="color:var(--color-terminal-code-text)">"Team sync"</span> --start <span style="color:var(--color-terminal-code-text)">"Mon 10:00"</span> --dur 1h

<span style="color:var(--color-terminal-muted)"># Delete event</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl delete --id abc123

<span style="color:var(--color-terminal-muted)"># Start MCP server</span>
<span style="color:var(--color-terminal-muted)">$ </span>calctl mcp`} />
  </section>

  <!-- MCP TOOLS -->
  <section style="padding: 4rem 1.5rem; background: var(--color-terminal-surface); border-top: 1px solid var(--color-terminal-border); border-bottom: 1px solid var(--color-terminal-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 0.5rem; letter-spacing: -0.02em;"><span class="lang-en">MCP Tools</span><span class="lang-de">MCP-Tools</span></h2>
      <p style="color: var(--color-terminal-dim); font-size: 0.875rem; margin: 0 0 2rem;"><span class="lang-en">Available via</span><span class="lang-de">Verfügbar über</span> <code style="font-family: 'JetBrains Mono', monospace; background: var(--color-terminal-bg); padding: 0.1em 0.4em; border-radius: 3px; color: #6366f1;">calctl mcp</code></p>
      <div style="border: 1px solid var(--color-terminal-border); border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: var(--color-terminal-bg); border-bottom: 1px solid var(--color-terminal-border);">
              <th style="text-align: left; padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--color-terminal-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; width: 35%;"><span class="lang-en">Tool</span><span class="lang-de">Tool</span></th>
              <th style="text-align: left; padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--color-terminal-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;"><span class="lang-en">Description</span><span class="lang-de">Beschreibung</span></th>
            </tr>
          </thead>
          <tbody>
            {mcpTools.map((tool: {name: string; desc: string}, i: number) => (
              <tr style={`background: ${i % 2 === 0 ? 'var(--color-terminal-surface)' : 'var(--color-terminal-code-bg)'}; border-bottom: 1px solid var(--color-terminal-border);`}>
                <td style="padding: 0.75rem 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; word-break: break-word; color: #6366f1;">{tool.name}</td>
                <td style="padding: 0.75rem 1.25rem; font-size: 0.875rem; color: var(--color-terminal-dim);">{tool.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- PRICING CTA -->
  <section style="padding: 5rem 1.5rem; text-align: center; max-width: 600px; margin: 0 auto;">
    <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--color-terminal-text); margin: 0 0 1rem; letter-spacing: -0.02em;">
      <span class="lang-en">Ready to give your AI hands?</span><span class="lang-de">Bereit, deiner KI Hände zu geben?</span>
    </h2>
    <p style="color: var(--color-terminal-dim); font-size: 1rem; line-height: 1.65; margin: 0 0 2rem;">
      <span class="lang-en">Free and open source. Or get the lifetime Bundle for all 9 tools &mdash; launch special: -30% with code L4uNch26.</span>
      <span class="lang-de">Kostenlos und Open Source. Oder hol dir das Lifetime-Bundle für alle 9 Tools &mdash; Launch-Special: -30% mit Code L4uNch26.</span>
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="https://github.com/aeon022/calctl/releases/latest" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; background: #6366f1; color: var(--color-terminal-bg); border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 700; text-decoration: none; transition: all 0.15s; box-shadow: 0 4px 20px rgba(99,102,241,0.2);"
            class="cta-primary">
            <span class="lang-en">Download &mdash; Free</span><span class="lang-de">Herunterladen &mdash; Kostenlos</span>
          </a>
      <a href="https://buy.polar.sh/polar_cl_kf5owZpIIKKtLjfO6wU3ofmYHecAixqxVZrmr1GMGOd" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; background: transparent; color: var(--color-terminal-text); border-radius: 6px; border: 1px solid var(--color-terminal-border); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.15s;"
            class="cta-secondary">
            <span class="lang-en">Get the Bundle &mdash; $39</span><span class="lang-de">Bundle holen &mdash; $39</span>
          </a>
      <a href="https://buy.polar.sh/polar_cl_FVeOLZeCaEh8wYJiRL6xifwn3VDvkt4KGjipA3u479F" target="_blank" rel="noopener"
        style="display: inline-flex; align-items: center; padding: 0.875rem 1.5rem; color: var(--color-terminal-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none;">
            <span class="lang-en">Unlock AI features &mdash; $9 (-30% w/ L4uNch26)</span><span class="lang-de">KI-Features freischalten &mdash; $9 (-30% mit L4uNch26)</span>
          </a>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr !important; }
    .features-grid { grid-template-columns: 1fr !important; }
  }
  .cta-primary:hover { background: #4f46e5 !important; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(99,102,241,0.3) !important; }
  .cta-secondary:hover { border-color: rgba(99,102,241,0.3) !important; color: #6366f1 !important; }
  .feature-card:hover { border-color: rgba(99,102,241,0.2) !important; }
</style>
