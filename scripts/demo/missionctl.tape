Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 640
Set Padding 12
Set TypingSpeed 40ms
Hide
Type "export PS1='$ '; taskctl add 'Ship v0.5.0' --due tomorrow >/dev/null; taskctl add 'Reply to support mail' >/dev/null; habctl add Meditate >/dev/null; habctl add Read >/dev/null; habctl check Meditate >/dev/null; budgetctl add Salary 3200 -c income >/dev/null; timectl start 'Release notes' >/dev/null; clear"
Enter
Sleep 3s
Show
Type "missionctl"
Enter
Sleep 3s
Type "T"
Sleep 1500ms
Down
Sleep 1200ms
Down
Sleep 1200ms
Enter
Sleep 2s
Type "q"
Sleep 500ms
