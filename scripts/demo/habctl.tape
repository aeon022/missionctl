Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 560
Set Padding 12
Set TypingSpeed 40ms
Hide
Type `export PS1='$ '; for h in Meditate Read "Walk 8k steps" Stretch; do habctl add "$h" >/dev/null; done; habctl check Meditate >/dev/null; habctl check Read >/dev/null; clear`
Enter
Show
Type "habctl"
Enter
Sleep 2s
Down
Sleep 600ms
Down
Sleep 600ms
Down
Sleep 600ms
Space
Sleep 1500ms
Type "q"
Sleep 500ms
