Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 560
Set Padding 12
Set TypingSpeed 40ms
Hide
Type "export PS1='$ '; budgetctl add Salary 3200 -c income >/dev/null; budgetctl add Rent -c housing -- -950 >/dev/null; budgetctl add Groceries -c food -- -84.30 >/dev/null; budgetctl add Coffee -c food -- -4.50 >/dev/null; budgetctl add Train -c transport -- -49 >/dev/null; clear"
Enter
Show
Type "budgetctl"
Enter
Sleep 2s
Down
Sleep 600ms
Tab
Sleep 1500ms
Tab
Sleep 1500ms
Type "q"
Sleep 500ms
