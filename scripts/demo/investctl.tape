Set Shell "bash"
Set FontSize 16
Set Width 1000
Set Height 560
Set Padding 12
Set TypingSpeed 40ms
Hide
Type "export PS1='$ '; bash $DEMO_DIR/seed-investctl.sh; clear"
Enter
Show
Type "investctl"
Enter
Sleep 2s
Down
Sleep 600ms
Down
Sleep 600ms
Tab
Sleep 1500ms
Tab
Sleep 1500ms
Type "q"
Sleep 500ms
